{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "author": "kirkwood",
  "name": "Setinox",
  "themes": [
    {
      "name": "Setinox",
      "appearance": "dark",
      "style": {
        "accents": [
          "#43A5D5",
          "#8EC43D",
          "#8B57B5",
          "#E0C64F",
          "#C22832",
          "#CACECD",
          "#E3BF21"
        ],

        "background": "#111213",
        "background.appearance": "opaque",

        "border": "#1c1e1f",
        "border.variant": "#1c1e1f",
        "border.focused": "#1c1e1f",
        "border.selected": "#8B57B5",
        "border.transparent": "#111213",
        "border.disabled": "#111213",

        "elevated_surface.background": "#111213",
        "surface.background": "#111213",
        "drop_target.background": "#111213",

        "element.background": "#1c1e1f",
        "element.hover": "#1c1e1f",
        "element.active": "#1e2021",
        "element.selected": "#1c1e1f",
        "element.disabled": "#1c1e1f",

        "ghost_element.background": null,
        "ghost_element.hover": "#1c1e1f",
        "ghost_element.active": "#1e2021",
        "ghost_element.selected": "#1c1e1f",
        "ghost_element.disabled": null,

        "text": "#CACECD",
        "text.muted": "#555859",
        "text.placeholder": "#3e4143",
        "text.disabled": "#555859",
        "text.accent": "#8B57B5",

        "icon": null,
        "icon.muted": null,
        "icon.disabled": null,
        "icon.placeholder": null,
        "icon.accent": null,
        "debugger.accent": "#43A5D5",

        "search.match_background": "#30323336",
        "search.active_match_background": "#303233FF",

        "status_bar.background": "#090a0b",
        "title_bar.background": "#090a0b",
        "title_bar.inactive_background": null,

        "tab_bar.background": "#111213",
        "tab.active_background": "#111213",
        "tab.inactive_background": "#111213",

        "toolbar.background": "#111213",

        "panel.background": "#111213",
        "panel.focused_border": null,
        "panel.overlay_background": "#111213",
        "panel.overlay_hover": null,
        "panel.indent_guide": null,
        "panel.indent_guide_active": null,
        "panel.indent_guide_hover": null,

        "pane.focused_border": null,
        "pane.group_border": null,

        "scrollbar.thumb.background": "#303233E3",
        "scrollbar.thumb.hover_background": "#43A5D5FF",
        "scrollbar.thumb.active_background": "#43A5D5E3",
        "scrollbar.thumb.border": null,
        "scrollbar.track.background": "#30323357",
        "scrollbar.track.border": null,

        "minimap.thumb.background": "#CACECD33",
        "minimap.thumb.hover_background": "#E0C64F66",
        "minimap.thumb.active_background": "#E0C64F66",
        "minimap.thumb.border": null,

        "editor.foreground": "#CACECD",
        "editor.background": "#111213",
        "editor.gutter.background": "#111213",
        "editor.subheader.background": null,
        "editor.active_line.background": "#3032334D",
        "editor.highlighted_line.background": null,
        "editor.line_number": "#3e4143",
        "editor.active_line_number": "#E0C64F",
        "editor.invisible": null,
        "editor.wrap_guide": "#2527298C",
        "editor.active_wrap_guide": "#252729FF",
        "editor.indent_guide": "#252729FF",
        "editor.indent_guide_active": "#303233FF",
        "editor.document_highlight.bracket_background": "#303233FF",
        "editor.document_highlight.read_background": null,
        "editor.document_highlight.write_background": null,

        "terminal.background": "#111213",
        "terminal.foreground": "#CACECD",
        "terminal.bright_foreground": "#FFFFFF",
        "terminal.dim_foreground": "#7a7e80",
        "terminal.ansi.background": null,
        "terminal.ansi.black": "#323232",
        "terminal.ansi.bright_black": "#323232",
        "terminal.ansi.red": "#C22832",
        "terminal.ansi.bright_red": "#C22832",
        "terminal.ansi.green": "#8EC43D",
        "terminal.ansi.bright_green": "#8EC43D",
        "terminal.ansi.yellow": "#E0C64F",
        "terminal.ansi.bright_yellow": "#E0C64F",
        "terminal.ansi.blue": "#43A5D5",
        "terminal.ansi.bright_blue": "#43A5D5",
        "terminal.ansi.magenta": "#8B57B5",
        "terminal.ansi.bright_magenta": "#8B57B5",
        "terminal.ansi.cyan": "#8EC43D",
        "terminal.ansi.bright_cyan": "#8EC43D",
        "terminal.ansi.white": "#EEEEEE",
        "terminal.ansi.bright_white": "#FFFFFF",
        "terminal.ansi.dim_black": "#222222",
        "terminal.ansi.dim_red": "#9e1f27",
        "terminal.ansi.dim_green": "#6d9630",
        "terminal.ansi.dim_yellow": "#b09e3e",
        "terminal.ansi.dim_blue": "#3483ab",
        "terminal.ansi.dim_magenta": "#6d4590",
        "terminal.ansi.dim_cyan": "#6d9630",
        "terminal.ansi.dim_white": "#bebebe",

        "link_text.hover": "#43A5D5",

        "version_control.added": "#8EC43D",
        "version_control.deleted": "#C22832",
        "version_control.modified": "#43A5D5",
        "version_control.renamed": "#43A5D5",
        "version_control.conflict": "#E0C64F",
        "version_control.ignored": "#555859",

        "conflict": "#E0C64F",
        "conflict.background": null,
        "conflict.border": null,
        "created": "#8EC43D",
        "created.background": null,
        "created.border": null,
        "deleted": "#C22832",
        "deleted.background": null,
        "deleted.border": null,
        "error": "#C22832",
        "error.background": "#2a1214",
        "error.border": null,
        "hidden": "#555859",
        "hidden.background": null,
        "hidden.border": null,
        "hint": "#555859",
        "hint.background": "#1a2010",
        "hint.border": null,
        "ignored": "#555859",
        "ignored.background": null,
        "ignored.border": null,
        "info": "#43A5D5",
        "info.background": "#0f1e2a",
        "info.border": null,
        "modified": "#43A5D5",
        "modified.background": null,
        "modified.border": null,
        "predictive": "#555859",
        "predictive.background": null,
        "predictive.border": null,
        "renamed": "#43A5D5",
        "renamed.background": null,
        "renamed.border": null,
        "success": "#8EC43D",
        "success.background": "#1a2a10",
        "success.border": null,
        "unreachable": null,
        "unreachable.background": null,
        "unreachable.border": null,
        "warning": "#E0C64F",
        "warning.background": "#2a250f",
        "warning.border": null,

        "players": [
          { "cursor": "#8EC43D", "background": "#8EC43DE3", "selection": "#8EC43D57" },
          { "cursor": "#43A5D5", "background": "#43A5D5E3", "selection": "#43A5D557" },
          { "cursor": "#8B57B5", "background": "#8B57B5E3", "selection": "#8B57B557" },
          { "cursor": "#E0C64F", "background": "#E0C64FE3", "selection": "#E0C64F57" },
          { "cursor": "#C22832", "background": "#C22832E3", "selection": "#C2283257" },
          { "cursor": "#CACECD", "background": "#CACECDE3", "selection": "#CACECD57" },
          { "cursor": "#E3BF21", "background": "#E3BF21E3", "selection": "#E3BF2157" },
          { "cursor": "#43A5D5", "background": "#43A5D5E3", "selection": "#43A5D557" }
        ],

        "syntax": {
          "boolean": { "color": "#E0C64F" },
          "comment": { "color": "#555859" },
          "comment.doc": { "color": "#555859" },
          "constant": { "color": "#E0C64F" },
          "constructor": { "color": "#43A5D5" },
          "embedded": { "color": "#CACECD" },
          "emphasis": { "color": "#CACECD", "font_style": "italic" },
          "emphasis.strong": { "color": "#C22832", "font_weight": 700 },
          "function": { "color": "#43A5D5" },
          "keyword": { "color": "#8B57B5" },
          "link_text": { "color": "#E0C64F" },
          "link_uri": { "color": "#E0C64F" },
          "number": { "color": "#E0C64F" },
          "operator": { "color": "#7a7e80" },
          "preproc": { "color": "#8B57B5" },
          "property": { "color": "#43A5D5" },
          "punctuation": { "color": "#7a7e80" },
          "punctuation.bracket": { "color": "#7a7e80" },
          "punctuation.delimiter": { "color": "#7a7e80" },
          "punctuation.list_marker": { "color": "#43A5D5" },
          "punctuation.markup": { "color": "#7a7e80" },
          "punctuation.special": { "color": "#7a7e80" },
          "string": { "color": "#8EC43D" },
          "string.escape": { "color": "#8EC43D" },
          "string.regex": { "color": "#8EC43D" },
          "string.special": { "color": "#43A5D5" },
          "string.special.symbol": { "color": "#C22832" },
          "tag": { "color": "#8B57B5" },
          "text.literal": { "color": "#8EC43D" },
          "title": { "color": "#43A5D5", "font_weight": 700 },
          "type": { "color": "#43A5D5" },
          "variable": { "color": "#CACECD" },
          "variable.special": { "color": "#C22832" }
        },

        "vim.normal.background": "#0f1c28",
        "vim.normal.foreground": "#CACECD",
        "vim.insert.background": "#182a0f",
        "vim.insert.foreground": "#CACECD",
        "vim.visual.background": "#251a35",
        "vim.visual.foreground": "#CACECD",
        "vim.visual_block.background": "#251a35",
        "vim.visual_block.foreground": "#CACECD",
        "vim.visual_line.background": "#251a35",
        "vim.visual_line.foreground": "#CACECD",
        "vim.replace.background": "#2a0f12",
        "vim.replace.foreground": "#CACECD",
        "vim.yank.background": "#EEEEEE",
        "vim.helix_normal.background": "#0f1c28",
        "vim.helix_normal.foreground": "#CACECD",
        "vim.helix_select.background": "#251a35",
        "vim.helix_select.foreground": "#CACECD"
      }
    }
  ]
}
